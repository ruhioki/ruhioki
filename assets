
<svg xmlns="http://www.w3.org/2000/svg" width="1500" height="430" viewBox="0 0 1500 430">
  <defs>
    <linearGradient id="bg" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#0D1117"/>
      <stop offset="50%" stop-color="#171126"/>
      <stop offset="100%" stop-color="#0D1117"/>
    </linearGradient>
    <linearGradient id="glow" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0%" stop-color="#A855F7">
        <animate attributeName="stop-color" values="#A855F7;#EC4899;#76B900;#A855F7" dur="9s" repeatCount="indefinite"/>
      </stop>
      <stop offset="100%" stop-color="#EC4899">
        <animate attributeName="stop-color" values="#EC4899;#76B900;#A855F7;#EC4899" dur="9s" repeatCount="indefinite"/>
      </stop>
    </linearGradient>
    <radialGradient id="orb">
      <stop offset="0%" stop-color="#A855F7" stop-opacity=".32"/>
      <stop offset="100%" stop-color="#A855F7" stop-opacity="0"/>
    </radialGradient>
    <pattern id="grid" width="38" height="38" patternUnits="userSpaceOnUse">
      <path d="M38 0H0V38" fill="none" stroke="#A855F7" stroke-opacity=".11" stroke-width="1"/>
    </pattern>
    <filter id="blur">
      <feGaussianBlur stdDeviation="35"/>
    </filter>
    <filter id="softGlow">
      <feGaussianBlur stdDeviation="4" result="blurred"/>
      <feMerge>
        <feMergeNode in="blurred"/>
        <feMergeNode in="SourceGraphic"/>
      </feMerge>
    </filter>
  </defs>

  <rect width="1500" height="430" rx="24" fill="url(#bg)"/>
  <rect width="1500" height="430" rx="24" fill="url(#grid)"/>

  <circle cx="250" cy="80" r="170" fill="url(#orb)" filter="url(#blur)">
    <animate attributeName="cx" values="250;420;250" dur="12s" repeatCount="indefinite"/>
  </circle>
  <circle cx="1270" cy="330" r="210" fill="url(#orb)" filter="url(#blur)">
    <animate attributeName="cy" values="330;230;330" dur="10s" repeatCount="indefinite"/>
  </circle>

  <!-- Circuit traces -->
  <g fill="none" stroke="url(#glow)" stroke-width="2" opacity=".7">
    <path d="M0 90H130L165 125H235"/>
    <path d="M0 115H95L125 145H190"/>
    <path d="M0 340H155L190 305H255"/>
    <path d="M1500 85H1380L1340 125H1270"/>
    <path d="M1500 110H1410L1375 145H1310"/>
    <path d="M1500 345H1370L1330 305H1260"/>
    <path d="M1040 0V45L1080 85V120"/>
    <path d="M1100 430V385L1140 345V315"/>
  </g>

  <g fill="#A855F7" filter="url(#softGlow)">
    <circle cx="130" cy="90" r="4"/>
    <circle cx="235" cy="125" r="4"/>
    <circle cx="95" cy="115" r="4"/>
    <circle cx="255" cy="305" r="4"/>
    <circle cx="1380" cy="85" r="4"/>
    <circle cx="1270" cy="125" r="4"/>
    <circle cx="1370" cy="345" r="4"/>
  </g>

  <!-- Abstract GPU chip -->
  <g transform="translate(1150 112)" stroke="url(#glow)" fill="none" stroke-width="3">
    <rect x="0" y="0" width="190" height="190" rx="20" fill="#0D1117" fill-opacity=".75"/>
    <rect x="24" y="24" width="142" height="142" rx="13" stroke-opacity=".7"/>
    <rect x="47" y="47" width="96" height="96" rx="9" stroke="#76B900" stroke-opacity=".9"/>
    <path d="M67 72H123M67 95H123M67 118H123" stroke="#76B900" stroke-width="5" stroke-linecap="round"/>
    <path d="M35 0V-20M70 0V-20M105 0V-20M140 0V-20M35 190V210M70 190V210M105 190V210M140 190V210"/>
    <path d="M0 35H-20M0 70H-20M0 105H-20M0 140H-20M190 35H210M190 70H210M190 105H210M190 140H210"/>
    <animateTransform attributeName="transform" type="translate" values="1150 112;1150 106;1150 112" dur="5s" repeatCount="indefinite"/>
  </g>

  <!-- Floating particles -->
  <g fill="#EC4899">
    <circle cx="1020" cy="90" r="3">
      <animate attributeName="cy" values="90;68;90" dur="4s" repeatCount="indefinite"/>
    </circle>
    <circle cx="1080" cy="330" r="4">
      <animate attributeName="cy" values="330;350;330" dur="5s" repeatCount="indefinite"/>
    </circle>
    <circle cx="1410" cy="220" r="3">
      <animate attributeName="cx" values="1410;1390;1410" dur="4s" repeatCount="indefinite"/>
    </circle>
    <circle cx="970" cy="260" r="3">
      <animate attributeName="cy" values="260;240;260" dur="3s" repeatCount="indefinite"/>
    </circle>
  </g>

  <!-- Main typography -->
  <text x="105" y="185" fill="#E6EDF3" font-family="Inter, Segoe UI, Arial, sans-serif" font-size="86" font-weight="800" letter-spacing="-3">ruhioki</text>

  <rect x="108" y="213" width="285" height="5" rx="2.5" fill="url(#glow)">
    <animate attributeName="width" values="180;285;180" dur="6s" repeatCount="indefinite"/>
  </rect>

  <text x="110" y="267" fill="#E6EDF3" font-family="Inter, Segoe UI, Arial, sans-serif" font-size="22" font-weight="600">AI &amp; DATA SCIENCE</text>
  <text x="110" y="306" fill="#C9B5FF" font-family="Inter, Segoe UI, Arial, sans-serif" font-size="19">GPU enthusiast · Aspiring AI Engineer</text>
  <text x="110" y="348" fill="#8B949E" font-family="JetBrains Mono, Consolas, monospace" font-size="15">LEARN  /  BUILD  /  EXPLORE</text>

  <rect x="0" y="423" width="1500" height="7" fill="url(#glow)"/>
</svg>
